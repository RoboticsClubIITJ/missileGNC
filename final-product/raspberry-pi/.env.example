# Copy this file to .env in the same folder and fill in your values.
# .env is ignored by git, so each person keeps their own.

# IP address of the computer running MATLAB/Simulink (not the Pi's own IP).
# On Windows: ipconfig. On Linux/macOS: ip addr or ifconfig.
SIMULINK_HOST=192.168.1.50

# UDP port. Must match the Port parameter of GimbalUDPReceiver in Simulink.
SIMULINK_PORT=25000
